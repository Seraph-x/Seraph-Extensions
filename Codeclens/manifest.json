{
  "manifest_version": 3,
  "name": "CodecLens — 编码数据自动识别与解码",
  "short_name": "CodecLens",
  "version": "1.2.0",
  "description": "自动扫描页面中的 Base64 / Base58 / Base32 / Hex / JWT / URL 编码 / HTML 实体 / Unicode 转义 等数据，实时高亮并一键解码。",
  "minimum_chrome_version": "105",
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "CodecLens — 编码识别与解码",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.chromewebstore.google.com/*",
        "*://chrome.google.com/webstore/*"
      ],
      "js": [
        "src/lib/util.js",
        "src/lib/codecs.js",
        "src/lib/detector.js",
        "src/content/highlighter.js",
        "src/content/tooltip.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-scan": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "开启/关闭 CodecLens 扫描"
    },
    "reload-pages": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "把最新代码重新注入所有页面（无需刷新）"
    }
  }
}
