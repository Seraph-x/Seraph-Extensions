{
  "manifest_version": 3,
  "name": "货币自动换算 · Auto Currency Converter",
  "version": "1.1.5",
  "description": "自动识别网页上的各种货币金额，并按实时汇率换算为你指定的货币。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/core.js",
        "lib/defaults.js",
        "lib/rates.js",
        "lib/bus.js",
        "lib/tip.js",
        "lib/engine.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "货币自动换算",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}